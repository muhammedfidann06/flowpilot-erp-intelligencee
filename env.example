# The static sample has NO environment variables or API secrets.
# A future server-side connector may use these names; they are not read by this release.
# ERP_BASE_URL=https://your-erp-host.example
# ERP_CLIENT_ID=server-side-only
# ERP_CLIENT_SECRET=server-side-only
# DATABASE_URL=postgresql://user:password@localhost:5432/flowpilot
# Never place credentials in dist/ or commit a populated .env file.
